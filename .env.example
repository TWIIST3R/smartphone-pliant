# Identifiants Amazon Creators API
# Associates Central › Outils › Creators API › votre application.
# Copiez ce fichier sous le nom .env (même dossier) puis remplissez-le.
# Ne partagez jamais ce fichier : il est exclu de Git.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
AMAZON_CREDENTIAL_VERSION=2.2
AMAZON_PARTNER_TAG=smartphone-pliant-21
AMAZON_MARKETPLACE=www.amazon.fr

# Clé API OpenAI (illustrations des articles), uniquement pour générer une image en local :
#   node --env-file=.env scripts/generate-cover.mjs --slug <slug> --prompt "<scène en anglais>"
# La routine cloud n'utilise pas ce fichier : la clé y est ajoutée comme « API credentials »
# de l'environnement claude.ai (hôte api.openai.com).
OPENAI_API_KEY=
