---
import BaseLayout from '../../layouts/BaseLayout.astro';
import KeyFacts from '../../components/KeyFacts.astro';
import CompareTable from '../../components/CompareTable.astro';
import PhoneCard from '../../components/PhoneCard.astro';
import Faq from '../../components/Faq.astro';
import Byline from '../../components/Byline.astro';
import Siblings from '../../components/Siblings.astro';
import { byId, overall } from '../../data/phones';
import { article, itemList } from '../../lib/schema';
import { euro, num } from '../../lib/format';

const path = '/smartphone-pliant-honor/';
const title = 'Smartphone pliant Honor : Magic V6 ou Magic V5 ?';
const description =
  'Smartphone pliant Honor : Magic V6 (2 299,90 €, 6 660 mAh, IP69, 8,75 mm) ou Magic V5 (1 999,90 €) ? Records, limites, duel avec Samsung et notre avis.';

const v6 = byId('honor-magic-v6');
const v5 = byId('honor-magic-v5');
const fold = byId('galaxy-z-fold8-ultra');

const duel = [
  { k: 'Batterie', h: '6 660 mAh', s: '5 000 mAh' },
  { k: 'Charge filaire', h: v6.wired, s: fold.wired },
  { k: 'Charge sans fil', h: v6.wireless, s: fold.wireless },
  { k: 'Protection', h: 'IP68 et IP69', s: fold.ip },
  { k: 'Épaisseur pliée', h: '8,75 mm', s: '8,9 mm' },
  { k: 'Épaisseur dépliée', h: '4 mm', s: '4,1 mm' },
  { k: 'Poids', h: '219 à 224 g', s: `${fold.weight} g` },
  { k: 'Écran intérieur', h: '7,95"', s: '8"' },
  { k: 'Téléobjectif', h: '64 Mpx périscope, x3', s: '10 Mpx, x3' },
  { k: 'Prix de lancement en 512 Go', h: euro(v6.launchPrice), s: '2 399 €' },
];

const faq = [
  {
    q: 'Quel est le meilleur smartphone pliant Honor ?',
    a: `Le Honor Magic V6, disponible en France depuis le 2 juillet 2026, est le plus complet : batterie de 6 660 mAh, charge 80 W, certifications IP68 et IP69, 8,75 mm d’épaisseur plié. Il obtient ${num(overall(v6))}/10 et mène notre classement. Le Magic V5 (${num(overall(v5))}/10), lancé en 2025 à 1 999,90 €, reste un très bon choix si son prix a nettement baissé.`,
  },
  {
    q: 'Les smartphones pliants Honor ont-ils les services Google ?',
    a: 'Oui. Contrairement aux pliants Huawei, les Honor Magic V6 et Magic V5 vendus en France fonctionnent sous Android avec la surcouche MagicOS et donnent accès aux services Google : Play Store, Gmail, Maps, YouTube et l’assistant Gemini. Aucune manipulation n’est nécessaire pour installer les applications habituelles.',
  },
  {
    q: 'Combien d’années de mises à jour sur un Honor Magic V6 ?',
    a: 'Honor s’engage à fournir sept ans de mises à jour Android et de correctifs de sécurité aux smartphones de sa série Magic vendus dans l’Union européenne et au Royaume-Uni. Annoncé en 2025, l’engagement a été confirmé en juin 2026 pour le Magic V6. Les versions destinées à d’autres marchés, vendues par des importateurs, ne sont pas concernées.',
  },
  {
    q: 'Que signifie la certification IP69 ?',
    a: 'L’indice IP69 certifie qu’un appareil est étanche à la poussière et résiste aux jets d’eau à haute pression et à haute température, un test plus sévère que l’immersion. Le Honor Magic V6 cumule IP68 et IP69, seul cas parmi les pliants de notre comparatif. Le Magic V5 s’arrête à IP58 et IP59, avec une protection partielle contre la poussière.',
  },
  {
    q: 'Honor Magic V6 ou Samsung Galaxy Z Fold8 Ultra ?',
    a: 'Sur la fiche technique, le Honor Magic V6 l’emporte : 6 660 mAh contre 5 000 mAh, charge 80 W contre 45 W, IP68 et IP69 contre IP48, 8,75 mm plié contre 8,9 mm. Le Samsung Galaxy Z Fold8 Ultra répond par un capteur principal de 200 Mpx, un écran de 8 pouces et une version 256 Go à 2 199 €, qu’Honor ne propose pas.',
  },
];

const schema = [
  article({ path, title, description, about: ['Honor Magic V6', 'Honor Magic V5', 'Smartphone pliant'] }),
  itemList('Smartphones pliants Honor vendus en France', [
    { name: v6.fullName, url: v6.path },
    { name: v5.fullName, url: v5.path },
  ]),
];
---

<BaseLayout title={title} description={description} schema={schema}>
  <article>
    <header class="wrap section-tight">
      <div class="prose">
        <span class="eyebrow">Honor · la fiche technique d’abord</span>
        <h1>Honor Magic V : les pliants qui gagnent sur la fiche technique</h1>
        <p class="lede">
          Honor vend deux smartphones pliants au format livre en France : le Magic V6, disponible depuis le 2 juillet 2026 à {euro(v6.launchPrice)}, et le Magic V5, lancé le 28 août 2025 à {euro(v5.launchPrice)}.
          Le premier mène notre <a href="/">classement général des smartphones pliants</a> avec {num(overall(v6))}/10, le second le suit à {num(overall(v5))}/10. Ce que ces chiffres disent, et ce qu’ils cachent.
        </p>
        <Byline minutes={8} />
      </div>
    </header>

    <div class="wrap">
      <KeyFacts
        items={[
          { label: 'Batterie Magic V6', value: '6 660 mAh' },
          { label: 'Épaisseur pliée', value: '8,75 mm' },
          { label: 'Étanchéité', value: 'IP68 + IP69' },
          { label: 'Charge filaire', value: '80 W' },
          { label: 'Charge sans fil', value: '66 W' },
          { label: 'Écran externe', value: '6 000 cd/m²' },
        ]}
      />
    </div>

    <section class="section">
      <div class="wrap prose">
        <h2 class="mt-0">Quatre records qui résument la méthode Honor</h2>
        <p>
          <strong>6 660 mAh.</strong> La batterie silicium-carbone du Honor Magic V6 est, selon Honor, la plus grosse d’un pliant vendu en Europe. Elle dépasse d’un tiers celle du Galaxy Z Fold8 Ultra (5 000 mAh). La chimie silicium-carbone stocke davantage d’énergie dans un même volume, ce qui permet de loger cette capacité dans un châssis fin.
        </p>
        <p>
          <strong>8,75 mm plié.</strong> Fermé, le Magic V6 est plus fin que tous les pliants au format livre de notre comparatif. Déplié, il descend à 4 mm. Le Magic V5 faisait déjà 8,8 mm en 2025 : Honor a gagné 840 mAh sans épaissir son téléphone.
        </p>
        <p>
          <strong>IP68 et IP69.</strong> L’IP68 garantit l’étanchéité à la poussière et la résistance à l’immersion ; l’IP69 y ajoute les jets d’eau à haute pression et à haute température. Aucun autre pliant de notre comparatif ne cumule les deux.
        </p>
        <p>
          <strong>80 W et 66 W sans fil.</strong> C’est la charge filaire la plus puissante des pliants que nous suivons. Même sa charge sans fil dépasse en puissance la charge filaire du Galaxy Z Fold8 Ultra (45 W) et du Pixel 11 Pro Fold (30 W).
        </p>
      </div>
    </section>

    <section class="section band">
      <div class="wrap">
        <div class="prose">
          <h2 class="mt-0">Ce qu’Honor fait mieux que Samsung</h2>
          <p>
            Le rival naturel du Honor Magic V6 est le Samsung Galaxy Z Fold8 Ultra, sorti le 7 août 2026. Ligne par ligne, Honor l’emporte sur presque tout ce qui se mesure.
          </p>
        </div>
        <div class="table-scroll" style="margin-top:1rem;max-width:820px">
          <table>
            <caption class="sr-only">Honor Magic V6 face au Samsung Galaxy Z Fold8 Ultra</caption>
            <thead>
              <tr><th scope="col">Caractéristique</th><th scope="col">Honor Magic V6</th><th scope="col">Samsung Galaxy Z Fold8 Ultra</th></tr>
            </thead>
            <tbody>
              {duel.map((r) => (
                <tr>
                  <th scope="row">{r.k}</th>
                  <td class="num">{r.h}</td>
                  <td class="num">{r.s}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <div class="prose" style="margin-top:1.4rem">
          <p>
            Trois écarts pèsent vraiment. La batterie d’abord : 1 660 mAh de plus, dans un appareil plus fin. L’étanchéité ensuite : l’indice IP48 de Samsung ne protège que des particules de plus de 1 mm, alors que le sable fin est l’ennemi numéro un d’une charnière.
            Le prix enfin, souvent oublié : à stockage égal (512 Go), le Magic V6 a été lancé 99,10 € moins cher que le Fold8 Ultra.
          </p>
          <p>
            Sur le zoom, les deux font jeu égal en grossissement (x3), mais Honor utilise un périscope de 64 Mpx là où Samsung se contente d’un capteur de 10 Mpx. Samsung garde en revanche l’avantage du capteur principal de 200 Mpx.
          </p>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap prose">
        <h2 class="mt-0">Ce qui peut faire hésiter</h2>
        <p>
          <strong>Un ticket d’entrée plus élevé.</strong> Honor ne vend le Magic V6 qu’en 16 Go / 512 Go, à 2 299,90 €. Samsung propose son Fold8 Ultra dès 2 199 € en 256 Go : qui n’a pas besoin de 512 Go paie donc 100,90 € de plus chez Honor. Et aucune version 1 To n’existe.
        </p>
        <p>
          <strong>Un prix public qui a beaucoup bougé.</strong> Pendant son offre de lancement, jusqu’au 31 juillet 2026, le Magic V6 était proposé à 1 699,90 €, soit 600 € sous son prix public. Un tel écart incite à comparer les offres avant d’acheter plutôt qu’à se fier au prix catalogue.
        </p>
        <p>
          <strong>MagicOS.</strong> La surcouche d’Honor, basée sur Android, est riche en réglages mais plus chargée qu’un Android de Pixel. Le suivi logiciel, lui, n’est plus un argument contre la marque : Honor promet sept ans de mises à jour Android et de sécurité pour sa série Magic vendue dans l’Union européenne et au Royaume-Uni, une durée identique à celle de Samsung.
        </p>
        <p>
          <strong>Une photo solide, pas la meilleure.</strong> Le zoom optique x3 du Magic V6 reste en deçà du x5 des Pixel Fold. Nous le notons 9,0/10 en photo, un cran sous le Pixel 11 Pro Fold et le Galaxy Z Fold8 Ultra (9,2).
        </p>
        <p>
          <strong>Un poids qui dépend du coloris.</strong> Le Magic V6 pèse 219 g en blanc et jusqu’à 224 g dans les autres finitions, soit 4 à 9 g de plus que le Fold8 Ultra.
        </p>
      </div>
    </section>

    <section class="section band">
      <div class="wrap">
        <div class="prose">
          <h2 class="mt-0">La gamme Magic V en France : deux générations, deux profils</h2>
          <p>
            Le <a href={v6.path}>Honor Magic V6</a> vise ceux qui veulent le pliant le plus endurant du marché et une étanchéité sans compromis. Par rapport à son prédécesseur, il gagne 840 mAh, 14 W en filaire, 16 W sans fil, le Snapdragon 8 Elite Gen 5 et la double certification IP68/IP69, pour un prix public supérieur de 300 €.
          </p>
          <p>
            Le <a href={v5.path}>Honor Magic V5</a> reste pertinent avec un budget plus serré. Il conserve 5 820 mAh, la charge sans fil 50 W, le même trio photo avec périscope 64 Mpx et 8,8 mm plié, seulement 0,05 mm de plus que le V6.
            Sa faiblesse face au modèle 2026 tient à sa protection IP58/IP59, qui n’assure pas une étanchéité totale à la poussière. Depuis la sortie du V6, il se trouve souvent nettement moins cher.
          </p>
        </div>
        <div class="stack" style="margin-top:1.4rem">
          <PhoneCard phone={v6} linkToSheet badge="N°1 de notre classement" ctaLabel="Voir le prix sur Amazon" />
          <PhoneCard phone={v5} linkToSheet ctaLabel="Consulter l’offre" />
        </div>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <div class="prose">
          <h2 class="mt-0">Magic V6 et Magic V5 : la fiche comparée</h2>
          <p>Les deux pliants Honor partagent le format, les 16 Go de mémoire vive et l’unique capacité de 512 Go. Le reste de la fiche montre où sont passés les 300 € d’écart.</p>
        </div>
        <div style="margin-top:1rem">
          <CompareTable
            phones={[v6, v5]}
            caption="Comparatif des smartphones pliants Honor Magic V6 et Magic V5"
            columns={['score', 'price', 'screens', 'chip', 'battery', 'charge', 'zoom', 'weight', 'thickness', 'ip']}
            linkNames
          />
        </div>
      </div>
    </section>

    <div class="wrap prose">
      <Faq items={faq} heading="Pliants Honor : les cinq questions qui reviennent" />
      <p class="small muted" style="margin-top:2rem">
        Analyse fondée sur les données d’Honor et les tests publiés, sans prise en main de notre part. Le calcul des notes est détaillé dans <a href="/methodologie/">notre méthodologie</a>.
      </p>
    </div>

    <div class="wrap">
      <Siblings path={path} variant="list" heading="Comparer avec les autres marques de pliants" />
    </div>
  </article>
</BaseLayout>
