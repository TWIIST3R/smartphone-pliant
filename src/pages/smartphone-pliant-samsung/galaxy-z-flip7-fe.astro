        <div class="card" style="margin-top:1rem">
          <span class="badge badge-gold">Fin de série</span>
          <p class="small" style="margin:.7rem 0 .3rem"><strong>Lancement :</strong> {euro(p.launchPrice)} ({p.launchConfig})</p>
          <p class="small muted">Production arrêtée en juillet 2026 : les stocks ne sont plus réapprovisionnés.</p>
          <AmazonButton phone={p} variant="ghost" size="sm" label="Comparer les offres" />
