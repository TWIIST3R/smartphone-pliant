                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="table-scroll" style="margin-top:1rem">
        <table>
          <caption class="sr-only">Coloris du Galaxy Z Fold8 Ultra vendus en France</caption>
          <thead>
            <tr><th scope="col">Coloris</th><th scope="col">Où le trouver</th></tr>
