</BaseLayout>

<script>
  const root = document.querySelector('[data-filters]');
  const table = document.querySelector<HTMLTableElement>('#comparatif-table');
  if (root && table) {
    const tbody = table.tBodies[0];
    const rows = Array.from(tbody.rows);
    const chips = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const select = root.querySelector<HTMLSelectElement>('[data-sort]');

    chips.forEach((chip) =>
      chip.addEventListener('click', () => {
        chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
        const f = chip.dataset.filter;
        rows.forEach((r) => (r.hidden = f !== 'all' && r.dataset.format !== f));
      }),
    );

    select?.addEventListener('change', () => {
      const v = select.value;
      const n = (r: HTMLTableRowElement, k: string) => Number(r.dataset[k] ?? 0);
      const sorted = [...rows].sort((a, b) => {
        switch (v) {
          case 'price-asc':
            return n(a, 'price') - n(b, 'price');
          case 'price-desc':
            return n(b, 'price') - n(a, 'price');
          case 'battery':
            return n(b, 'battery') - n(a, 'battery');
          case 'weight':
            return n(a, 'weight') - n(b, 'weight');
          case 'release':
            return (b.dataset.release ?? '').localeCompare(a.dataset.release ?? '');
          default:
            return n(b, 'score') - n(a, 'score');
        }
      });
      sorted.forEach((r) => tbody.appendChild(r));
    });
  }
</script>
