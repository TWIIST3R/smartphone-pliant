---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page introuvable" description="Cette page n’existe pas ou a été déplacée." noindex ogType="website">
  <section class="section">
    <div class="wrap prose">
      <span class="eyebrow">Erreur 404</span>
      <h1>Cette page s’est repliée sur elle-même</h1>
      <p class="lede">L’adresse demandée n’existe pas ou a changé. Le plus simple est de repartir du comparatif.</p>
      <p><a class="btn btn-amazon" href="/">Retour au comparatif des smartphones pliants</a></p>
    </div>
  </section>
</BaseLayout>
