---
// Silhouette schématique d'un pliant (pas de photo produit : aucun problème de droits).
import type { Format } from '../data/phones';

interface Props {
  format: Format;
  color?: string;
  label?: string;
}

const { format, color = '#e2471b', label } = Astro.props;
---

{
  format === 'clapet' && (
    <svg class="fold-icon" viewBox="0 0 80 120" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
      <rect x="20" y="6" width="40" height="108" rx="9" fill="none" stroke="currentColor" stroke-width="3" />
      <rect x="25" y="12" width="30" height="42" rx="4" fill={color} opacity=".9" />
      <rect x="25" y="66" width="30" height="42" rx="4" fill={color} opacity=".35" />
      <path d="M16 60h48" stroke="currentColor" stroke-width="2" stroke-dasharray="3 3" />
    </svg>
  )
}
{
  format === 'livre' && (
    <svg class="fold-icon" viewBox="0 0 120 120" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
      <rect x="8" y="14" width="104" height="92" rx="9" fill="none" stroke="currentColor" stroke-width="3" />
      <rect x="14" y="20" width="43" height="80" rx="4" fill={color} opacity=".9" />
      <rect x="63" y="20" width="43" height="80" rx="4" fill={color} opacity=".45" />
      <path d="M60 8v104" stroke="currentColor" stroke-width="2" stroke-dasharray="3 3" />
    </svg>
  )
}
{
  format === 'tri-pliant' && (
    <svg class="fold-icon" viewBox="0 0 150 110" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}>
      <rect x="6" y="10" width="138" height="90" rx="9" fill="none" stroke="currentColor" stroke-width="3" />
      <rect x="12" y="16" width="38" height="78" rx="4" fill={color} opacity=".9" />
      <rect x="56" y="16" width="38" height="78" rx="4" fill={color} opacity=".6" />
      <rect x="100" y="16" width="38" height="78" rx="4" fill={color} opacity=".35" />
      <path d="M53 4v102M97 4v102" stroke="currentColor" stroke-width="2" stroke-dasharray="3 3" />
    </svg>
  )
}
