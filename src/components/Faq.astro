---
// FAQ accessible (details/summary) + balisage FAQPage.
// Une seule FAQ par page. Les réponses sont en texte brut (pas de HTML) pour le JSON-LD.
import { faqPage } from '../lib/schema';

interface Props {
  items: { q: string; a: string }[];
  heading?: string;
  id?: string;
  openFirst?: boolean;
}

const { items, heading = 'Questions fréquentes', id = 'faq', openFirst = false } = Astro.props;
const ld = { '@context': 'https://schema.org', ...faqPage(items) };
---

<section id={id}>
  <h2>{heading}</h2>
  <div class="faq">
    {
      items.map((it, i) => (
        <details open={openFirst && i === 0}>
          <summary>{it.q}</summary>
          <div class="answer">
            <p>{it.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</section>
<script type="application/ld+json" set:html={JSON.stringify(ld)} />
